# Copy to .env.local for development. Compose overrides only.
#
# `.env` is for the production pipeline. `.env.local` overrides it.
#
# config.py holds the defaults. A key that repeats one belongs nowhere near
# this file - change the default instead.

REDIS_URL=redis://redis:6379/0
POSTGRES_URL=postgresql://pythonapi:pythonapi@pythonapi-db:5432/pythonapi
QDRANT_URL=http://qdrant:6333
VOICE_FACTORY_URL=http://host.docker.internal:8100

LLM_BASE_URL=http://litellm:4000/v1

# EMBEDDING_DIM moves with EMBEDDING_PROVIDER: mock is 64, nomic-embed is 768.
# Qdrant fixes a collection's vector size at creation, so recreate it after.
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_DIM=768
RERANK_PROVIDER=cross_encoder
GENERATION_PROVIDER=baml

CORS_ALLOW_ORIGINS=http://localhost:4001,http://localhost:3000
