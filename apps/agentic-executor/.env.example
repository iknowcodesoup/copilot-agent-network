# Copy to .env.local for development. Next.js reads .env.local before .env,
# and skips it when NODE_ENV is test, so Jest stays clean.

# The nginx proxy (infra/nginx/nginx.conf) puts the app and the API behind
# one HTTPS origin, so the browser reaches FastAPI at /api/* on that same
# origin. Leave this empty - endpoints.ts and copilot_provider.tsx both fall
# back to a relative URL, which is what makes that work. Set it only if you
# run the API on a separate origin (no nginx, direct port access).
#
# Next inlines NEXT_PUBLIC_* at build time, so rebuild the web image after a
# change.
NEXT_PUBLIC_PYTHON_API_URL=
