# Copy to .env.local for development. Next.js reads .env.local before .env,
# and skips it when NODE_ENV is test, so Jest stays clean.

# Next inlines NEXT_PUBLIC_* at build time, so rebuild the web image after a
# change. Must agree with CORS_ALLOW_ORIGINS in apps/pythonapi/.env.local.
NEXT_PUBLIC_PYTHON_API_URL=http://localhost:8000
