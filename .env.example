# Copy to .env.local for development. Holds what more than one service needs,
# plus every secret. Per-app settings live in apps/<app>/.env.example.
#
# `.env` is for the production pipeline. `.env.local` overrides it, and Compose
# treats both as optional.

# Nx loads .env.local and .env at the workspace root, so the flag below must
# stay. Without it Nx pushes the compose host names into `nx test` and
# `nx serve`, which cannot reach them.
NX_LOAD_DOT_ENV_FILES=false

# Which box serves each LiteLLM alias. The alias names themselves are fixed in
# litellm.config.yaml, because the fallback rule keys on them.
#
# chat-default -> LM Studio. Primary.
LITELLM_UPSTREAM_API_BASE=http://host.docker.internal:1234/v1
LITELLM_CHAT_BACKEND_MODEL=openai/google/gemma-4-e4b
LITELLM_EMBEDDING_BACKEND_MODEL=openai/text-embedding-nomic-embed-text-v1.5@q8_0

# chat-backup -> LiteRT. The gateway falls back here when LM Studio is down.
# Neither box takes an API key. Set nothing for them.
LITELLM_UPSTREAM2_API_BASE=http://host.docker.internal:9379/v1
LITELLM_CHAT2_BACKEND_MODEL=openai/gemma-4-12B-it-gpu.litertlm

LANGFUSE_HOST=http://langfuse:3000
NEXTAUTH_URL=http://localhost:4002
LANGFUSE_INIT_ORG_ID=local-org
LANGFUSE_INIT_ORG_NAME=Local Org
LANGFUSE_INIT_PROJECT_ID=pythonapi
LANGFUSE_INIT_PROJECT_NAME=pythonapi
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=Local Admin

# Secrets. openssl rand -base64 32, except ENCRYPTION_KEY which needs -hex 32.
# An unset PII key disables masking outright, so raw PII flows through.
LANGFUSE_PUBLIC_KEY=replace-me
LANGFUSE_SECRET_KEY=replace-me
NEXTAUTH_SECRET=replace-me
SALT=replace-me
ENCRYPTION_KEY=replace-me
LANGFUSE_INIT_USER_PASSWORD=replace-me
# The LiteLLM master key, and the only LLM credential this stack has. Leave it
# unset for a local gateway: the app then sends no Authorization header at all.
# It is not LM Studio's or LiteRT's key - both are keyless.
#LLM_API_KEY=replace-me
PII_VAULT_ENCRYPTION_KEY=replace-me
PII_VAULT_SALT=replace-me
HF_TOKEN=replace-me
# Shared with the voice factory in the star-trek-voyicer repo. Both sides need
# the same value, or every job webhook comes back 401. Unset, the webhook route
# answers 503 and the reconcile timer carries the pipeline on its own.
VOICE_WEBHOOK_TOKEN=replace-me

#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   openssl rand -base64 32
#
#   echo "sk-$(openssl rand -hex 16)"