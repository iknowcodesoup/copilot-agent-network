## Required
LANGFUSE_PUBLIC_KEY=replace-with-langfuse-public-key
LANGFUSE_SECRET_KEY=replace-with-langfuse-secret-key
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
SALT=replace-with-openssl-rand-base64-32
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
LANGFUSE_INIT_USER_PASSWORD=replace-with-langfuse-admin-password
LITELLM_MASTER_KEY=replace-with-litellm-master-key
LITELLM_UPSTREAM_API_KEY=replace-with-upstream-api-key
PII_VAULT_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
PII_VAULT_SALT=replace-with-openssl-rand-base64-32
HF_TOKEN=replace-with-hugging-face-access-token

## Optional
REDIS_URL=redis://redis:6379/0
PYTHONAPI_POSTGRES_URL=postgresql://pythonapi:pythonapi@pythonapi-db:5432/pythonapi
QDRANT_URL=http://qdrant:6333
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_INIT_ORG_ID=local-org
LANGFUSE_INIT_ORG_NAME=Local Org
LANGFUSE_INIT_PROJECT_ID=pythonapi
LANGFUSE_INIT_PROJECT_NAME=pythonapi
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=Local Admin
NEXTAUTH_URL=http://localhost:4002

# The CopilotKit v2 chat connects to the Python agent straight from the
# browser over AG-UI, so these two must agree: the URL below is what the
# browser dials, and CORS_ALLOW_ORIGINS is the web origin FastAPI accepts.
# Next inlines NEXT_PUBLIC_* at build time - rebuild the web image after
# changing it, don't just restart the container.
NEXT_PUBLIC_PYTHON_API_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=http://localhost:4001
LITELLM_UPSTREAM_API_BASE=http://host.docker.internal:1234/v1
LITELLM_CHAT_BACKEND_MODEL=google/gemma-4-e4b
LITELLM_EMBEDDING_BACKEND_MODEL=text-embedding-nomic-embed-text-v1.5@q4_k_m
EMBEDDING_DIM=768

