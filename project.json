{
  "name": "apps",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "root": ".",
  "projectType": "application",
  "targets": {
    "config": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "local",
      "options": {
        "cwd": "."
      },
      "configurations": {
        "local": {
          "command": "docker compose --env-file .env.local --env-file apps/agentic-executor/.env.local config"
        },
        "production": {
          "command": "docker compose --env-file .env --env-file apps/agentic-executor/.env config"
        }
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "local",
      "options": {
        "cwd": "."
      },
      "configurations": {
        "local": {
          "command": "docker compose --env-file .env.local --env-file apps/agentic-executor/.env.local build"
        },
        "production": {
          "command": "docker compose --env-file .env --env-file apps/agentic-executor/.env build"
        }
      }
    },
    "up": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "local",
      "options": {
        "cwd": "."
      },
      "configurations": {
        "local": {
          "command": "docker compose --env-file .env.local --env-file apps/agentic-executor/.env.local up --build"
        },
        "production": {
          "command": "docker compose --env-file .env --env-file apps/agentic-executor/.env up --build"
        }
      }
    },
    "watch": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "local",
      "options": {
        "cwd": "."
      },
      "configurations": {
        "local": {
          "command": "docker compose --env-file .env.local --env-file apps/agentic-executor/.env.local -f docker-compose.yml -f docker-compose.watch.yml up --build --watch"
        },
        "production": {
          "command": "docker compose --env-file .env --env-file apps/agentic-executor/.env -f docker-compose.yml -f docker-compose.watch.yml up --build --watch"
        }
      }
    },
    "down": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "local",
      "options": {
        "cwd": "."
      },
      "configurations": {
        "local": {
          "command": "docker compose --env-file .env.local --env-file apps/agentic-executor/.env.local down"
        },
        "production": {
          "command": "docker compose --env-file .env --env-file apps/agentic-executor/.env down"
        }
      }
    },

    "watch-down": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "local",
      "options": {
        "cwd": "."
      },
      "configurations": {
        "local": {
          "command": "docker compose -f docker-compose.watch.yml --env-file .env.local --env-file apps/agentic-executor/.env.local down"
        },
        "production": {
          "command": "docker compose -f docker-compose.watch.yml --env-file .env --env-file apps/agentic-executor/.env down"
        }
      }
    }
  },
  "tags": ["type:ops"]
}
